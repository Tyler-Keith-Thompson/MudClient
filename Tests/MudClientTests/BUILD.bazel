load("@rules_swift//swift:swift.bzl", "swift_test")

swift_test(
    name = "MudClientTests",
    size = "small",
    srcs = glob(["*.swift"]),
    # The Lua-script load tests and raw-log repros load the REAL scripts from runfiles (resolved via
    # #filePath). Depend on the globbed //Scripts:lua_srcs filegroup — the SAME set the app + Lua suite
    # load — so a script that requires a sibling (e.g. AlterAeon.lua -> Foundation/Parse.lua) resolves,
    # and a newly added/moved script is never silently dropped (the old hand-list went stale at the
    # Foundation/AlterAeon reorg, so every load("Scripts")/require test broke).
    data = [
        "//Scripts:lua_srcs",
        "//Sources/MudClient:swift_srcs",
        "fixtures/pellam_kxwt_capture.log",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//Sources/MudClient:MudClientLib",
        "@swift_parsing//:Parsing",
        "@swiftpkg_dependencyinjection//:DependencyInjection",
        "@swiftpkg_mockable//:Mockable",
    ],
)
